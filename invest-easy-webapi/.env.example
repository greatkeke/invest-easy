# CORS origins configuration
ALLOW_ORIGINS=http://localhost:4200,http://localhost:3000

# FutuOpenD connection settings
FUTU_OPEND_HOST=127.0.0.1
FUTU_OPEND_PORT=1000

# FutuOpenD protocol encryption (enable to use encrypted communication)
ENABLE_PROTO_ENCRYPT=false
# Path to RSA private key file for FutuOpenD encryption
# When using Docker: /invest-easy-webapi/certs/rsa_private_key.pem
# When running locally: C:\path\to\rsa_private_key.pem or /path/to/rsa_private_key.pem
RSA_FILE_PATH=

# Logging configuration
LOG_PATH=./logs
LOG_LEVEL=INFO
LOG_MAX_SIZE=50
LOG_BACKUP_COUNT=5

# Third-party API keys
NEWS_API_KEY=
DEEPSEEK_API_KEY=

# Feature flags
ENABLE_AK_INITIALIZATION=false
